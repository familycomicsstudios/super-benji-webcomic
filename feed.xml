---
layout: null
permalink: /feed.xml
---
<?xml version="1.0" encoding="UTF-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">

    <generator uri="https://jekyllrb.com" version="{{ jekyll.version }}">
        Jekyll
    </generator>

    <title>{{ site.title | xml_escape }}</title>
    <subtitle>{{ site.description | xml_escape }}</subtitle>

    <link href="{{ '/feed.xml' | absolute_url }}"
          rel="self"
          type="application/atom+xml"/>

    <link href="{{ '/' | absolute_url }}"
          rel="alternate"
          type="text/html"/>

    <id>{{ '/' | absolute_url }}</id>

    <updated>{{ site.time | date_to_xmlschema }}</updated>

    {% assign comics = site.comics | sort: "number" | reverse %}

    {% for comic in comics limit:10 %}

    <entry>

        <title>{{ comic.title | xml_escape }}</title>

        <link href="{{ comic.url | absolute_url }}"
              rel="alternate"
              type="text/html"
              title="{{ comic.title | xml_escape }}"/>

        <id>{{ comic.url | absolute_url }}</id>

        <updated>{{ site.time | date_to_xmlschema }}</updated>

        <author>
            <name>{{ site.author | default: site.title | xml_escape }}</name>
        </author>

        <content type="html">
            <![CDATA[
            {% if comic.image %}
            <img src="{{ comic.image | absolute_url }}"
                 alt="{{ comic.title | xml_escape }}">
            {% endif %}

            {{ comic.content }}
            ]]>
        </content>

        <summary>
            {{ comic.excerpt | strip_html | xml_escape }}
        </summary>

    </entry>

    {% endfor %}

</feed>